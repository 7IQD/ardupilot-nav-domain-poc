# --- ArduPilot Nav-Domain POC .gitignore ---

# 1. Block all heavy data formats (Vault)
*.BIN
*.tlog
*.parquet
*.pyc
__pycache__/

# --- Environment & Security ---
.env
.env.local
.env.*.local
.venv/
venv-*/

# 2. Block general text files to avoid "junk"
*.txt
*.log
*.csv

# 3. EXCEPTION: Allow evidence and documentation
!tests/evidence/*.txt
!tests/evidence/*.md
!tests/evidence/*.pdf

# 4. OS / IDE noise
.DS_Store
.vscode/
.idea/

# --- Block Data Vaults ---
/bin/vault/vault_b/
/bin/vault/warehouse_df/
bin/vault/df_source/
bin/vault/vault_a/
bin/vault/vault_c/
src/ingress/bin/
*.duckdb

# --- Legacy & Archive ---
src/archive/