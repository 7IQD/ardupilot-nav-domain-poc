# ---------- Raw flight logs ----------
*.BIN
*.bin
*.tlog

# ---------- Vault storage (generated data) ----------
bin/vault/*

# Allow placeholder
!bin/vault/.gitkeep

# ---------- Parquet data ----------
*.parquet

# ---------- Databases ----------
*.db
*.duckdb

# ---------- Reports ----------
*.csv
*.xlsx

# ---------- Logs ----------
*.log
*.txt

# ---------- Test evidence ----------
tests/evidence/

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class

# ---------- Virtual environments ----------
venv/
.venv/

# ---------- IDE ----------
.vscode/
.idea/

# ---------- Environment ----------
.env

# ---------- Notebooks ----------
notebooks/
*.ipynb

# ---------- Docs temporary ----------
docs/Temp-Learning/

# ---------- Images ----------
!images/*.png
!images/*.PNG
!images/*.jpg
!images/*.jpeg

# ---------- System junk ----------
.DS_Store
Thumbs.db