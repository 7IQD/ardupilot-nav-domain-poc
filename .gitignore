# --- Python & Environment ---
!**/bin/vault/**/.gitkeep
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.env
.pytest_cache/

# --- ArduPilot Domain Data (The Vaults) ---
# We ignore the content, but allow the directories if they contain a .gitkeep
bin/vault/vault_a/*
bin/vault/vault_b/*
bin/vault/vault_c/**/*

# Ignore SQLite leftovers from previous POC versions
*.db
*.db-journal
*.db-wal

# --- Logs & Binary Artifacts ---
logs/*.log
*.log
bin/
src/bin/

# --- Documentation & Work-in-Progress ---
docs/Temp-Learning/
*.tmp
*.bak*.tlog
*.tlog.raw
